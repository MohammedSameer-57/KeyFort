<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minWidth="340dp"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tv_guest_pass_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/guest_pass_title"
        android:textAppearance="?attr/textAppearanceTitleLarge"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <!-- Duration Selection Step -->
    <LinearLayout
        android:id="@+id/layout_duration_selection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/duration_title"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="?attr/colorPrimary"
            android:layout_marginBottom="8dp" />

        <RadioGroup
            android:id="@+id/rg_duration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <RadioButton
                android:id="@+id/rb_duration_5m"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/duration_5m" />

            <RadioButton
                android:id="@+id/rb_duration_15m"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/duration_15m" />

            <RadioButton
                android:id="@+id/rb_duration_1h"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/duration_1h" />
        </RadioGroup>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_generate_pass"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/generate_link" />
    </LinearLayout>

    <!-- Link Ready & Status Step -->
    <LinearLayout
        android:id="@+id/layout_link_ready"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/link_ready"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="?attr/colorPrimary"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tv_guest_link"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#EAE8E0"
            android:padding="12dp"
            android:fontFamily="monospace"
            android:textColor="#1B1C18"
            android:textSize="13sp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tv_status_chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#DEE0FF"
            android:textColor="#00006E"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="@string/status_waiting"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_share_link"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/share_link"
                android:layout_marginEnd="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_copy_link"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/copy_link"
                style="@style/Widget.Material3.Button.TonalButton" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_end_session"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/end_session_now"
            android:backgroundTint="#BA1A1A"
            android:textColor="#FFFFFF"
            android:visibility="gone"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_close_pass"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/ok"
            style="@style/Widget.Material3.Button.TextButton" />
    </LinearLayout>

</LinearLayout>
