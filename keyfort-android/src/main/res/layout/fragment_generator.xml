<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:paddingBottom="32dp">

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/generator_title"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            android:textStyle="bold" />

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/generator_subtitle"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="16dp" />

        <!-- Mode Switcher: Password vs Passphrase -->
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggle_gen_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:singleSelection="true"
            app:selectionRequired="true"
            app:checkedButton="@id/btn_mode_password">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_mode_password"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/mode_password" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_mode_passphrase"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/mode_passphrase" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- Hero Output Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="?attr/colorSurface"
            app:strokeWidth="1dp"
            app:strokeColor="#2A777680">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:id="@+id/tv_password_result"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textSize="19sp"
                    android:lineSpacingExtra="5dp"
                    android:textColor="?attr/colorOnSurface"
                    android:textIsSelectable="true"
                    android:minHeight="52dp"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="14dp" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progress_strength"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progress="100"
                    app:trackCornerRadius="4dp"
                    app:trackThickness="6dp"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tv_entropy_summary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceLabelMedium"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:layout_marginBottom="14dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_generate"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:text="@string/regenerate"
                        app:icon="@drawable/ic_refresh"
                        app:iconSize="18dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_copy"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/copy"
                        app:icon="@drawable/ic_copy"
                        app:iconTint="?attr/colorOnPrimary"
                        app:iconSize="18dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_clipboard_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorPrimary"
                    android:layout_marginTop="8dp"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Configuration Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="?attr/colorSurface"
            app:strokeWidth="1dp"
            app:strokeColor="#2A777680">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <!-- Password Options -->
                <LinearLayout
                    android:id="@+id/group_password_options"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/password_length_title"
                            android:textAppearance="?attr/textAppearanceTitleSmall" />

                        <TextView
                            android:id="@+id/tv_length_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="?attr/colorPrimaryContainer"
                            android:textColor="?attr/colorOnPrimaryContainer"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp"
                            android:fontFamily="monospace"
                            android:textAppearance="?attr/textAppearanceLabelMedium"
                            android:text="@string/password_length_label_default" />
                    </LinearLayout>

                    <com.google.android.material.slider.Slider
                        android:id="@+id/slider_length"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:valueFrom="8.0"
                        android:valueTo="64.0"
                        android:stepSize="1.0"
                        android:value="20.0"
                        app:tickVisible="false"
                        app:labelBehavior="gone"
                        android:layout_marginBottom="8dp" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_upper"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:checked="true"
                        android:text="@string/uppercase" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_lower"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:checked="true"
                        android:text="@string/lowercase" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_digits"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:checked="true"
                        android:text="@string/digits" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_symbols"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:checked="true"
                        android:text="@string/symbols" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_avoid_ambiguous"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:checked="false"
                        android:text="@string/avoid_ambiguous" />
                </LinearLayout>

                <!-- Passphrase Options -->
                <LinearLayout
                    android:id="@+id/group_passphrase_options"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/word_count_title"
                            android:textAppearance="?attr/textAppearanceTitleSmall" />

                        <TextView
                            android:id="@+id/tv_word_count_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="?attr/colorPrimaryContainer"
                            android:textColor="?attr/colorOnPrimaryContainer"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp"
                            android:fontFamily="monospace"
                            android:textAppearance="?attr/textAppearanceLabelMedium"
                            android:text="@string/word_count_label_default" />
                    </LinearLayout>

                    <com.google.android.material.slider.Slider
                        android:id="@+id/slider_word_count"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:valueFrom="3.0"
                        android:valueTo="10.0"
                        android:stepSize="1.0"
                        android:value="5.0"
                        app:tickVisible="false"
                        app:labelBehavior="gone"
                        android:layout_marginBottom="10dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/separator_title"
                        android:textAppearance="?attr/textAppearanceLabelMedium"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:layout_marginBottom="6dp" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chips_separator"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:singleSelection="true"
                        app:selectionRequired="true"
                        android:layout_marginBottom="12dp">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_sep_hyphen"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="@string/sep_hyphen" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_sep_dot"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/sep_dot" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_sep_underscore"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/sep_underscore" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_sep_space"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/sep_space" />
                    </com.google.android.material.chip.ChipGroup>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_capitalize"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:checked="true"
                        android:text="@string/capitalize_words" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_include_number"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:checked="true"
                        android:text="@string/include_number" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Ephemeral In-Memory Recent History -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_recent_history"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="?attr/colorSurface"
            app:strokeWidth="1dp"
            app:strokeColor="#2A777680">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/recent_in_memory"
                    android:textAppearance="?attr/textAppearanceLabelMedium"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:id="@+id/container_recent_items"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
